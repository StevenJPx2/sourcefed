{
  "name": "@fdcn/sourcefed",
  "version": "0.5.0",
  "description": "Live Jira, GitHub, and Slack monitoring for agent hosts: CLI, daemon, MCP server, and host plugins.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/StevenJPx2/sourcefed.git",
    "directory": "packages/sourcefed"
  },
  "type": "module",
  "bin": {
    "sourcefed": "./dist/cli.js"
  },
  "files": [
    "dist",
    "dist.dts",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist.dts/packages/cli/src/index.d.ts",
      "default": "./dist/cli.js"
    },
    "./core": {
      "types": "./dist.dts/packages/core/src/index.d.ts",
      "default": "./dist/core.js"
    },
    "./core/storage": {
      "types": "./dist.dts/packages/core/src/storage/index.d.ts",
      "default": "./dist/core-storage.js"
    },
    "./daemon": {
      "types": "./dist.dts/packages/daemon/src/index.d.ts",
      "default": "./dist/daemon.js"
    },
    "./mcp": {
      "types": "./dist.dts/packages/mcp/src/index.d.ts",
      "default": "./dist/mcp.js"
    },
    "./server": {
      "types": "./dist.dts/packages/sourcefed/src/server.d.ts",
      "default": "./dist/opencode.js"
    },
    "./opencode": {
      "types": "./dist.dts/adapters/opencode/index.d.ts",
      "default": "./dist/opencode.js"
    },
    "./opencode/tui": {
      "types": "./dist.dts/adapters/opencode/tui.d.ts",
      "default": "./dist/tui-compiled.mjs"
    },
    "./tui": {
      "types": "./dist.dts/adapters/opencode/tui.d.ts",
      "default": "./dist/tui-compiled.mjs"
    },
    "./pi": {
      "types": "./dist.dts/adapters/pi/src/index.d.ts",
      "default": "./dist/pi.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@opencode/plugin": "2.2.7",
    "@types/json-schema": "7.0.15",
    "valibot": "1.4.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": { "optional": true },
    "@earendil-works/pi-tui": { "optional": true },
    "typebox": { "optional": true }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./dist/pi.js"
    ]
  }
}
