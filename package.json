{
  "name": "sourcefed",
  "version": "0.2.0",
  "description": "Live Jira, GitHub, and Slack monitoring for agent hosts.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/StevenJPx2/sourcefed.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./tui": "./tui.ts",
    "./guidance": "./GUIDANCE.md",
    "./core": "./packages/core/src/index.ts",
    "./mcp": "./packages/mcp/src/index.ts",
    "./cli": "./apps/cli/src/index.ts",
    "./pi": "./adapters/pi/src/index.ts"
  },
  "dependencies": {
    "@sourcefed/core": "workspace:*",
    "@sourcefed/mcp": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "typescript": "^5.9.2"
  },
  "workspaces": [
    "packages/*",
    "packages/providers/*",
    "apps/*",
    "adapters/*"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun test && bun run typecheck",
    "sourcefed": "bun run apps/cli/src/index.ts"
  }
}
