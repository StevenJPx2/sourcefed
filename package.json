{
  "name": "sourcefed",
  "version": "0.2.6",
  "description": "Live Jira, GitHub, and Slack monitoring for agent hosts.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/StevenJPx2/sourcefed.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./tui": "./tui.ts",
    "./guidance": "./GUIDANCE.md",
    "./core": "./packages/core/dist/index.js",
    "./daemon": "./packages/daemon/dist/index.js",
    "./mcp": "./packages/mcp/dist/index.js",
    "./cli": "./packages/cli/dist/index.js",
    "./pi": "./adapters/pi/src/index.ts"
  },
  "dependencies": {
    "@sourcefed/core": "*",
    "@sourcefed/mcp": "*"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "changelogen": "^0.6.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.2"
  },
  "workspaces": [
    "packages/*",
    "providers/*",
    "adapters/*"
  ],
  "scripts": {
    "postinstall": "node scripts/build.mjs",
    "build": "node scripts/build.mjs",
    "build:public": "node scripts/build-public.mjs && node scripts/build-dts.mjs",
    "build:tests": "node scripts/build-tests.mjs",
    "test": "node --test '**/dist-tests/**/*.test.js'",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/build.mjs && node scripts/build-tui.mjs && node scripts/build-public.mjs && node scripts/build-dts.mjs && node scripts/build-tests.mjs && node --test '**/dist-tests/**/*.test.js' && tsc --noEmit",
    "sourcefed": "node packages/cli/dist/index.js",
    "integration": "node scripts/integration.mjs",
    "build:tui": "node scripts/build-tui.mjs",
    "release": "changelogen --release --push",
    "release:publish": "node scripts/release/publish.mjs",
    "release:pins": "node scripts/release/pins.mjs"
  }
}
