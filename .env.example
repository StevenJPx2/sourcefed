# Jira polling
SOURCEFED_JIRA_BASE_URL=https://your-workspace.atlassian.net
ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_API_KEY=replace-me

# Optional Jira terminal status. Leave unset to keep Jira monitors active.
SOURCEFED_JIRA_TERMINAL_STATUS=

# Optional webhook transports
SOURCEFED_GITHUB_WEBHOOK_SECRET=replace-me
SOURCEFED_SLACK_SIGNING_SECRET=replace-me
SOURCEFED_WEBHOOK_HOST=127.0.0.1
SOURCEFED_WEBHOOK_PORT=8788

# Direct API polling
# GH_TOKEN or GITHUB_TOKEN authenticates GitHub polling
# SOURCEFED_SLACK_TOKEN=xoxb-replace-me authenticates Slack polling

# Optional shared daemon (default http://127.0.0.1:18787)
SOURCEFED_DAEMON_URL=http://127.0.0.1:18787
SOURCEFED_DAEMON_HOST=127.0.0.1
SOURCEFED_DAEMON_PORT=18787

# Required when binding the daemon to a non-loopback address
# SOURCEFED_DAEMON_TOKEN=replace-me

# Optional skills directory override
# SOURCEFED_SKILLS_DIR=/path/to/skills
