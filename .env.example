# Jira polling
SOURCEFED_JIRA_BASE_URL=https://your-workspace.atlassian.net
ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_API_KEY=replace-me

# Optional Jira terminal status. Leave unset to keep Jira monitors active.
SOURCEFED_JIRA_TERMINAL_STATUS=

# Optional webhook transports
SOURCEFED_GITHUB_WEBHOOK_SECRET=replace-me
SOURCEFED_SLACK_SIGNING_SECRET=replace-me
SOURCEFED_WEBHOOK_HOST=127.0.0.1
SOURCEFED_WEBHOOK_PORT=8787
